{
  "name": "Meow Userbot",
  "description": "Pyrogram userbot with music system.",
  "logo": "",
  "keywords": [
    "Telegram",
    "MusicPlayer",
    "VideoPlayer"
  ],
  "repository": "https://github.com/BRANDED-THUNDER/Meow",
  "env": {
    "SESSION": {
      "description": "Pyrogram String Session",
      "required": true
    },
    "API_ID": {
      "description": "APP ID from my.telegram.org/apps",
      "required": true
    },
    "API_HASH": {
      "description": "API hash from my.telegram.org/apps",
      "required": true
    },
    "HNDLR": {
      "description": "Command handler. Leave empty if you use .",
      "required": false
    },
    "AlIVE_MSG": {
      "description": "Enter your alive message",
      "required": false
    },
    "ALIVE_PIC": {
      "description": "Enter your alive picture URL",
      "required": false
    },
    "PING_MSG": {
      "description": "Enter your ping message",
      "required": false
    },
    "SUDO_USERS": {
      "description": "Sudo users for VC plugin",
      "required": true
    }
  },
  "addons": [],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "Eco"
    }
  },
  "stack": "container"
}
